### other

# Authorization Token serving as "root" access to routes, shouldn't be disclosed!
# !!! REQUIRED !!!
CIMG_ROOT_SECRET = "XXX"

### elysia plugins

# JWT secret for tokens, shouldn't be disclosed!
# !!! REQUIRED !!!
CIMG_ELY_JWT_SECRET = ""

### elysia

CIMG_ELY_HOSTNAME = "0.0.0.0"
CIMG_ELY_PORT = "3000"

### image service settings

# Maximum file size of an image uploaded to server
# default: 10MB
CIMG_FS_MAX_SIZE = "10485760" # must be calculated before hand (<MB> * 1024 * 1024)
# Lifetime of a file before removing it
# default: 7 days
CIMG_FS_LIFETIME = "604800" # must be calculated before hand (<DAYS> * 24 * 60 * 60)
# Interval at which files will be marked for cleanup
# default: 60 minutes
CIMG_FS_CLEANUP_INTERVAL = "60"